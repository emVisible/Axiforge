  "keyGrammar": [
    {
      "type": "memory",
      "rule": "flat: 键就是键，不分段",
      "segments": "flat"
    },
    {
      "type": "flag",
      "rule": "flat: 键就是键，不分段",
      "segments": "flat"
    },
    {
      "type": "character_state",
      "rule": "切**第一个**点：前段是 characterId，**其余整体**是字段名 ⇒ 字段名可以带点",
      "segments": "first-dot-rest"
    },
    {
      "type": "relationship",
      "rule": "按点切，取第 1/2/3 段，**第 4 段起被静默丢弃** ⇒ 字段名不能带点",
      "segments": "third-segment-only"
    },
    {
      "type": "codex",
      "rule": "切**第一个**点：前段是 characterRefId，**其余整体**是记忆键 ⇒ 记忆键可以带点",
      "segments": "first-dot-rest"
    },
    {
      "type": "node_completed",
      "rule": "不看 key，看 value 是不是走过的节点 id",
      "segments": "flat"
    }
  ],

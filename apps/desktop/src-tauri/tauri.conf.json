{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiforge",
  "version": "0.1.0",
  "identifier": "com.axiforge.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @axiforge/web dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm --filter @axiforge/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Axiforge",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
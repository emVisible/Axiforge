{
  "name": "axiforge",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup-db.sh",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "bash scripts/run-dev.sh all",
    "dev:web": "bash scripts/run-dev.sh web",
    "dev:admin": "bash scripts/run-dev.sh admin",
    "dev:nexus": "bash scripts/run-dev.sh nexus",
    "dev:api": "bash scripts/run-dev.sh api",
    "dev:tmux": "bash dev.bash",
    "dev:desktop": "pnpm --filter @axiforge/desktop dev",
    "build:desktop": "pnpm --filter @axiforge/desktop build",
    "dev:kill": "bash scripts/kill-dev-ports.sh",
    "build": "pnpm --filter @axiforge/web build && pnpm --filter @axiforge/admin build",
    "test:api": "cd backend && uv run pytest tests/ -v",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "pnpm --filter @axiforge/web lint && pnpm --filter @axiforge/admin lint:colors",
    "typecheck": "pnpm -r --filter @axiforge/core --filter @axiforge/axs --filter @axiforge/editor-core typecheck && pnpm --filter @axiforge/web exec tsc -b",
    "test:unit": "pnpm --filter @axiforge/core test && pnpm --filter @axiforge/axs test && pnpm --filter @axiforge/editor-core test && pnpm --filter @axiforge/web test && pnpm --filter @axiforge/admin test",
    "coverage": "pnpm --filter @axiforge/core test:coverage && pnpm --filter @axiforge/editor-core test:coverage",
    "check:size": "node scripts/check-file-size.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:purity": "node scripts/check-package-purity.mjs",
    "check:circular": "dpdm --no-warning --no-tree --exit-code circular:1 \"packages/core/src/index.ts\" \"packages/axs/src/index.ts\" \"packages/editor-core/src/index.ts\" \"packages/ui/src/index.ts\"",
    "check:desktop": "pnpm --filter @axiforge/desktop check",
    "gates": "pnpm typecheck && pnpm test:unit && pnpm lint && pnpm check:purity && pnpm check:circular && pnpm check:size && pnpm check:contrast"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.2.0",
    "dpdm": "^4.3.0"
  },
  "packageManager": "pnpm@10.8.1"
}

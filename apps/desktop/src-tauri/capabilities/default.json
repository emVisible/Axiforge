{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口能力：核心 + 打开器 + 全局快捷键 + 本地素材目录（ADR-024）",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/Documents/Axiforge/**"
        },
        {
          "path": "$HOME/Documents/Axiforge"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "sql:default",
    "sql:allow-execute"
  ]
}